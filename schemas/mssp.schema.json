{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/mssp/0.1/project.schema.json",
  "title": "MSSP Project Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "layers",
    "policies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "FMS",
        "SCL",
        "SMS",
        "TMS",
        "DMS"
      ],
      "properties": {
        "FMS": {
          "type": "string",
          "minLength": 1
        },
        "SCL": {
          "type": "string",
          "minLength": 1
        },
        "SMS": {
          "type": "string",
          "minLength": 1
        },
        "TMS": {
          "type": "string",
          "minLength": 1
        },
        "DMS": {
          "type": "string",
          "minLength": 1
        },
        "ROUTER": {
          "type": "string",
          "minLength": 1
        },
        "RUNTIME": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fmsExecutableFiles",
        "tmsDirectDependency",
        "smsDependsOnTms",
        "requireFmsReview"
      ],
      "properties": {
        "fmsExecutableFiles": {
          "enum": [
            "deny",
            "warn"
          ]
        },
        "tmsDirectDependency": {
          "enum": [
            "deny",
            "warn"
          ]
        },
        "smsDependsOnTms": {
          "enum": [
            "deny",
            "warn"
          ]
        },
        "requireFmsReview": {
          "type": "boolean"
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
