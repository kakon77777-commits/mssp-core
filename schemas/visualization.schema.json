{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/mssp/visualization.schema.json",
  "title": "MSSP Visualization Model v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generatedBy",
    "project",
    "view",
    "groups",
    "nodes",
    "edges",
    "invariants"
  ],
  "properties": {
    "schemaVersion": { "const": "0.3" },
    "kind": { "const": "mssp-visualization-model" },
    "generatedBy": { "$ref": "#/$defs/generatedBy" },
    "project": { "$ref": "#/$defs/project" },
    "view": { "$ref": "#/$defs/view" },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "autoMutation"],
      "properties": {
        "readOnly": { "const": true },
        "autoMutation": { "const": false }
      }
    }
  },
  "$defs": {
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "adapter"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "direction", "interactive", "sourceNavigation"],
      "properties": {
        "layout": { "const": "layered" },
        "direction": { "const": "left-to-right" },
        "interactive": { "const": true },
        "sourceNavigation": { "type": "boolean" }
      }
    },
    "groupId": {
      "enum": [
        "FMS",
        "SCL",
        "SMS",
        "TMS",
        "DMS",
        "ROUTER",
        "RUNTIME",
        "UNCLASSIFIED",
        "UNRESOLVED"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/groupId" },
        "label": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri"],
      "properties": {
        "kind": { "enum": ["manifest", "scanner", "adapter", "generated"] },
        "uri": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "group",
        "status",
        "source",
        "sourceUri"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["module", "candidate", "reference"] },
        "label": { "type": "string", "minLength": 1 },
        "group": { "$ref": "#/$defs/groupId" },
        "status": { "enum": ["declared", "unclassified", "unresolved"] },
        "source": { "$ref": "#/$defs/source" },
        "sourceUri": { "type": "string", "minLength": 1 },
        "sourceHref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "riskLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "boundaryKind": { "enum": ["repository", "package", "source-root", "directory"] },
        "boundaryConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "fileCount": { "type": "integer", "minimum": 0 },
        "sourceFileCount": { "type": "integer", "minimum": 0 },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "label", "source", "evidenceCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["requires", "affects", "affected-by"] },
        "label": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "evidenceCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
