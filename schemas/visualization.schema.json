{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/mssp/visualization.schema.json",
  "title": "MSSP Visualization Model v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generatedBy",
    "project",
    "view",
    "groups",
    "projections",
    "nodes",
    "edges",
    "scale",
    "invariants"
  ],
  "properties": {
    "schemaVersion": { "const": "0.3" },
    "kind": { "const": "mssp-visualization-model" },
    "generatedBy": { "$ref": "#/$defs/generatedBy" },
    "project": { "$ref": "#/$defs/project" },
    "view": { "$ref": "#/$defs/view" },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/projection" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "scale": { "$ref": "#/$defs/scale" },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnly", "autoMutation"],
      "properties": {
        "readOnly": { "const": true },
        "autoMutation": { "const": false }
      }
    }
  },
  "$defs": {
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "adapter"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "projectionId": {
      "enum": ["layer", "status", "risk", "connectivity"]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "direction",
        "interactive",
        "sourceNavigation",
        "defaultProjection",
        "availableProjections"
      ],
      "properties": {
        "layout": { "const": "layered" },
        "direction": { "const": "left-to-right" },
        "interactive": { "const": true },
        "sourceNavigation": { "type": "boolean" },
        "defaultProjection": { "$ref": "#/$defs/projectionId" },
        "availableProjections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projectionId" }
        }
      }
    },
    "groupId": {
      "enum": [
        "FMS",
        "SCL",
        "SMS",
        "TMS",
        "DMS",
        "ROUTER",
        "RUNTIME",
        "UNCLASSIFIED",
        "UNRESOLVED"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/groupId" },
        "label": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "groupBy", "groups"],
      "properties": {
        "id": { "$ref": "#/$defs/projectionId" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "groupBy": {
          "enum": ["architecture-layer", "node-status", "risk-level", "relation-degree"]
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectionGroup" }
        }
      }
    },
    "projectionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "order", "nodeIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 },
        "nodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri"],
      "properties": {
        "kind": { "enum": ["manifest", "scanner", "adapter", "generated"] },
        "uri": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "group",
        "status",
        "source",
        "sourceUri"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["module", "candidate", "reference"] },
        "label": { "type": "string", "minLength": 1 },
        "group": { "$ref": "#/$defs/groupId" },
        "status": { "enum": ["declared", "unclassified", "unresolved"] },
        "source": { "$ref": "#/$defs/source" },
        "sourceUri": { "type": "string", "minLength": 1 },
        "sourceHref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "riskLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "boundaryKind": { "enum": ["repository", "package", "source-root", "directory"] },
        "boundaryConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "fileCount": { "type": "integer", "minimum": 0 },
        "sourceFileCount": { "type": "integer", "minimum": 0 },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind", "label", "source", "evidenceCount"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["requires", "affects", "affected-by"] },
        "label": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "evidenceCount": { "type": "integer", "minimum": 0 }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeCount",
        "edgeCount",
        "largeGraph",
        "threshold",
        "initialNodeLimit",
        "batchSize",
        "maxRenderedEdges",
        "nodeRendering",
        "edgeRendering"
      ],
      "properties": {
        "nodeCount": { "type": "integer", "minimum": 0 },
        "edgeCount": { "type": "integer", "minimum": 0 },
        "largeGraph": { "type": "boolean" },
        "threshold": { "type": "integer", "minimum": 1 },
        "initialNodeLimit": { "type": "integer", "minimum": 1 },
        "batchSize": { "type": "integer", "minimum": 1 },
        "maxRenderedEdges": { "type": "integer", "minimum": 1 },
        "nodeRendering": { "const": "bounded-batch" },
        "edgeRendering": { "const": "visible-endpoints-only" }
      }
    }
  }
}
