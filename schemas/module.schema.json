{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/mssp/0.1/module.schema.json",
  "title": "MSSP Module Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "layer",
    "purpose",
    "inputs",
    "outputs",
    "requires",
    "permissions",
    "riskLevel",
    "failureModes",
    "validation",
    "tests",
    "compatibility",
    "changeImpact"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "enum": [
        "FMS",
        "SCL",
        "SMS",
        "TMS",
        "DMS",
        "ROUTER",
        "RUNTIME"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "activateWhen": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modules",
        "tools",
        "data"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may",
        "mayNot"
      ],
      "properties": {
        "may": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "mayNot": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "riskLevel": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "failureModes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mssp"
      ],
      "properties": {
        "mssp": {
          "type": "string"
        },
        "modules": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "changeImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affects",
        "affectedBy"
      ],
      "properties": {
        "affects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "affectedBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "maintainer": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "layer": {
            "const": "TMS"
          }
        }
      },
      "then": {
        "required": [
          "activateWhen"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "layer": {
            "enum": [
              "FMS",
              "SCL"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "entry"
          ]
        }
      }
    }
  ]
}
