{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MSSP Adapter Descriptor v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "version", "sourceEcosystem", "input", "output", "capabilities", "invariants"],
  "properties": {
    "schemaVersion": { "const": "0.3" },
    "kind": { "const": "mssp-adapter-descriptor" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "sourceEcosystem": { "type": "string", "minLength": 1 },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion", "format"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaVersion"],
      "properties": {
        "kind": { "const": "mssp-intermediate-model" },
        "schemaVersion": { "const": "0.2" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "candidates", "relations", "policies", "evidence"],
      "properties": {
        "modules": { "type": "boolean" },
        "candidates": { "type": "boolean" },
        "relations": { "type": "boolean" },
        "policies": { "type": "boolean" },
        "evidence": { "type": "boolean" }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "readOnly", "noExecution", "noNetwork", "autoPromotion", "autoMutation"],
      "properties": {
        "deterministic": { "const": true },
        "readOnly": { "const": true },
        "noExecution": { "const": true },
        "noNetwork": { "const": true },
        "autoPromotion": { "const": false },
        "autoMutation": { "const": false }
      }
    }
  }
}
