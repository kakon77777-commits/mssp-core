{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/mssp/router-evaluation.schema.json",
  "title": "MSSP Router Evaluation Report v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generatedBy",
    "sourceModel",
    "request",
    "evaluation",
    "candidates",
    "findings",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "0.4" },
    "kind": { "const": "mssp-router-evaluation-report" },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "evaluator"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "evaluator": { "const": "router-contract-evaluator" }
      }
    },
    "sourceModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "projectName", "projectVersion"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "minLength": 1 },
        "projectVersion": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "request": { "$ref": "#/$defs/request" },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "conditionLanguage",
        "compatibilityLanguage",
        "deterministic",
        "readOnly",
        "noExecution",
        "noNetwork",
        "autoActivation",
        "autoMutation",
        "runtimeCompatibilityProof"
      ],
      "properties": {
        "mode": { "const": "static-contract" },
        "conditionLanguage": { "const": "mssp-exact-condition-v0.4" },
        "compatibilityLanguage": { "const": "numeric-comparator-range-v0.4" },
        "deterministic": { "const": true },
        "readOnly": { "const": true },
        "noExecution": { "const": true },
        "noNetwork": { "const": true },
        "autoActivation": { "const": false },
        "autoMutation": { "const": false },
        "runtimeCompatibilityProof": { "const": false }
      }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ok",
        "totalCandidates",
        "eligible",
        "rejected",
        "indeterminate",
        "selectedModuleIds",
        "eligibleModuleIds"
      ],
      "properties": {
        "status": { "enum": ["selected", "ambiguous", "no-match", "indeterminate"] },
        "ok": { "type": "boolean" },
        "totalCandidates": { "type": "integer", "minimum": 0 },
        "eligible": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "indeterminate": { "type": "integer", "minimum": 0 },
        "selectedModuleIds": { "$ref": "#/$defs/stringSet" },
        "eligibleModuleIds": { "$ref": "#/$defs/stringSet" }
      }
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "factValue": {
      "type": ["string", "number", "boolean", "null"]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "intent",
        "facts",
        "msspVersion",
        "availableInputs",
        "requiredOutputs",
        "availableModules",
        "availableTools",
        "availableData",
        "requestedPermissions",
        "maxRiskLevel"
      ],
      "properties": {
        "schemaVersion": { "const": "0.4" },
        "kind": { "const": "mssp-router-request" },
        "requestId": { "type": "string", "minLength": 1 },
        "intent": { "type": "string", "minLength": 1 },
        "facts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/factValue" }
        },
        "msspVersion": { "type": "string", "minLength": 1 },
        "availableInputs": { "$ref": "#/$defs/stringSet" },
        "requiredOutputs": { "$ref": "#/$defs/stringSet" },
        "availableModules": { "$ref": "#/$defs/stringSet" },
        "availableTools": { "$ref": "#/$defs/stringSet" },
        "availableData": { "$ref": "#/$defs/stringSet" },
        "requestedPermissions": { "$ref": "#/$defs/stringSet" },
        "maxRiskLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "targetModules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "status", "message", "data"],
      "properties": {
        "code": { "type": "string", "pattern": "^MSSP_ROUTE_[0-9]{3}$" },
        "category": {
          "enum": [
            "target",
            "activation",
            "input",
            "output",
            "dependency",
            "tool",
            "data",
            "permission",
            "risk",
            "compatibility"
          ]
        },
        "status": { "enum": ["rejected", "indeterminate"] },
        "message": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moduleId",
        "name",
        "version",
        "riskLevel",
        "decision",
        "matchedConditions",
        "reasons"
      ],
      "properties": {
        "moduleId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "riskLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "decision": { "enum": ["eligible", "rejected", "indeterminate"] },
        "matchedConditions": { "$ref": "#/$defs/stringSet" },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/reason" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "data"],
      "properties": {
        "code": { "type": "string", "pattern": "^MSSP_ROUTE_[0-9]{3}$" },
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      }
    }
  }
}
