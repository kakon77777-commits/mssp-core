{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/schemas/mssp/0.2/promotion-review.schema.json",
  "title": "MSSP Candidate Promotion Review v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "reviewId",
    "generatedBy",
    "sourceModel",
    "candidate",
    "classification",
    "review",
    "promotion"
  ],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "kind": { "const": "mssp-candidate-promotion-review" },
    "reviewId": {
      "type": "string",
      "pattern": "^promotion-review\\.[a-f0-9]{16}$"
    },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "adapter"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "adapter": { "const": "promotion-review" }
      }
    },
    "sourceModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "projectName", "scannerAdapter", "truncated"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "minLength": 1 },
        "scannerAdapter": { "type": "string", "minLength": 1 },
        "truncated": { "type": "boolean" },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path",
        "boundaryKind",
        "boundaryConfidence",
        "fileCount",
        "sourceFileCount",
        "languages"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "boundaryKind": {
          "enum": ["repository", "package", "source-root", "directory"]
        },
        "boundaryConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "fileCount": { "type": "integer", "minimum": 0 },
        "sourceFileCount": { "type": "integer", "minimum": 0 },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "classification": { "$ref": "#/$defs/classificationSuggestion" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "reviewedAt", "outcome", "rationale", "conditions"],
      "properties": {
        "actor": { "$ref": "#/$defs/actor" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["approve", "reject", "defer"] },
        "selectedLayer": { "$ref": "#/$defs/layer" },
        "rationale": { "type": "string", "minLength": 1 },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "contractDraft": {
      "type": "object"
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blockers", "requiresIndependentApproval"],
      "properties": {
        "status": { "enum": ["not-approved", "blocked", "eligible"] },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "requiresIndependentApproval": { "const": true }
      }
    }
  },
  "$defs": {
    "layer": {
      "enum": ["FMS", "SCL", "SMS", "TMS", "DMS", "ROUTER", "RUNTIME"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "agent"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri"],
      "properties": {
        "kind": { "enum": ["manifest", "scanner", "adapter", "generated"] },
        "uri": { "type": "string", "minLength": 1 },
        "format": { "type": "string" },
        "adapter": { "type": "string" },
        "revision": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": {
          "enum": ["declaration", "source", "dependency", "policy", "inference", "test", "other"]
        },
        "message": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "data": { "type": "object" }
      }
    },
    "classificationSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidatePath",
        "status",
        "suggestedLayer",
        "confidence",
        "supportScore",
        "alternativeLayers",
        "supportingEvidence",
        "counterEvidence",
        "unresolvedQuestions"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "candidatePath": { "type": "string", "minLength": 1 },
        "status": { "const": "review-required" },
        "suggestedLayer": {
          "oneOf": [
            { "$ref": "#/$defs/layer" },
            { "const": "UNDETERMINED" }
          ]
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "supportScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "alternativeLayers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer", "supportScore"],
            "properties": {
              "layer": { "$ref": "#/$defs/layer" },
              "supportScore": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "supportingEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "counterEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "unresolvedQuestions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
