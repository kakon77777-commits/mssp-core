{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MSSP Classification Suggestions v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "generatedBy", "sourceModel", "classification"],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "kind": { "const": "mssp-classification-suggestions" },
    "generatedBy": { "$ref": "#/$defs/generatedBy" },
    "sourceModel": { "$ref": "#/$defs/sourceModel" },
    "classification": { "$ref": "#/$defs/classification" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "layer": { "enum": ["FMS", "SCL", "SMS", "TMS", "DMS", "ROUTER", "RUNTIME"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri"],
      "properties": {
        "kind": { "enum": ["manifest", "scanner", "adapter", "generated"] },
        "uri": { "$ref": "#/$defs/nonEmptyString" },
        "format": { "$ref": "#/$defs/nonEmptyString" },
        "adapter": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message"],
      "properties": {
        "kind": { "enum": ["declaration", "source", "dependency", "policy", "inference", "test", "other"] },
        "message": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/source" },
        "data": { "type": "object", "additionalProperties": true }
      }
    },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "adapter"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "adapter": { "const": "static-layer-classifier" }
      }
    },
    "sourceModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "projectName", "scannerAdapter", "truncated"],
      "properties": {
        "projectId": { "$ref": "#/$defs/nonEmptyString" },
        "projectName": { "$ref": "#/$defs/nonEmptyString" },
        "scannerAdapter": { "$ref": "#/$defs/nonEmptyString" },
        "truncated": { "type": "boolean" },
        "revision": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "mode", "autoPromotion"],
      "properties": {
        "id": { "const": "mssp-static-layer-heuristics" },
        "version": { "const": "0.2" },
        "mode": { "const": "advisory" },
        "autoPromotion": { "const": false }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "supportScore"],
      "properties": {
        "layer": { "$ref": "#/$defs/layer" },
        "supportScore": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "candidatePath",
        "status",
        "suggestedLayer",
        "confidence",
        "supportScore",
        "alternativeLayers",
        "supportingEvidence",
        "counterEvidence",
        "unresolvedQuestions"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/nonEmptyString" },
        "candidatePath": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "const": "review-required" },
        "suggestedLayer": {
          "oneOf": [
            { "$ref": "#/$defs/layer" },
            { "const": "UNDETERMINED" }
          ]
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "supportScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "alternativeLayers": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/alternative" }
        },
        "supportingEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "counterEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "unresolvedQuestions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "suggestions"],
      "properties": {
        "method": { "$ref": "#/$defs/method" },
        "suggestions": {
          "type": "array",
          "items": { "$ref": "#/$defs/suggestion" }
        }
      }
    }
  }
}
